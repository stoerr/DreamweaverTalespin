# Ignore lazily generated story artifacts
stories/*/outline.json
stories/*/feed.rss
stories/*/outline.tmp
stories/*/feed.tmp
stories/*/*.epub
stories/*/epub


# Chapter text and locks
stories/*/chapters/*.md
stories/*/chapters/*.tmp

# Audio outputs and locks
stories/*/audio/*.mp3
stories/*/audio/*.tmp
stories/*/audio/*.m3u
stories/*/audio/*.zip
stories/*/cover.jpg
